# Copy to .env (gitignored) and fill in what you need.

# Enables the research agent. Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model for the research agent
# Gemini model. gemini-2.5-flash (default) and gemini-2.5-flash-lite include free Google Search grounding.
# RESEARCH_MODEL=gemini-2.5-flash

# Where the SQLite database lives (default: ./data, which is gitignored)
# DATA_DIR=./data

# Port and interface. Keep 127.0.0.1 unless you are exposing the app.
# PORT=8787
# HOST=127.0.0.1

# Required before exposing the app beyond localhost: a login password.
# APP_PASSWORD=

# Follow-up notifications are sent from this hour (server local time, 0-23).
# NOTIFY_HOUR=8
# TZ=America/Toronto
